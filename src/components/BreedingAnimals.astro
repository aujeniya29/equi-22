---
import { Image } from 'astro:assets';

interface Animal {
  nom: string;
  role: 'etalon' | 'pouliniere' | 'poulain';
  race?: string;
  anneeNaissance?: number;
  photo?: string;
  photos?: string[];
  photoPosition?: string;
  prix?: string;
  prixReservation?: string;
  prixPoulainVivant?: string;
  description: string;
  pere?: string;
  mere?: string;
  pereDeMere?: string;
  palmares?: string[];
}

interface Props {
  animals: Animal[];
  bgClass: string;
}

const { animals, bgClass } = Astro.props;

const roleOrder: Animal['role'][] = ['etalon', 'pouliniere', 'poulain'];
const roleLabels: Record<Animal['role'], string> = {
  etalon: 'Étalons',
  pouliniere: 'Poulinières',
  poulain: 'Poulains & Pouliches',
};

const prixLabels: Record<Animal['role'], string | null> = {
  etalon: 'Tarif saillie',
  pouliniere: null,
  poulain: 'Prix de vente',
};

const groups = roleOrder
  .map((role) => ({ role, items: animals.filter((a) => a.role === role) }))
  .filter((g) => g.items.length > 0);

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/elevage/*.{jpg,jpeg,png,webp}'
);
---

<section class={`py-12 lg:py-16 ${bgClass}`}>
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-10 text-center">
      Nos chevaux
    </h2>

    {groups.map(({ role, items }) => (
      <div class="mb-12 last:mb-0">
        <h3 class="text-xl font-serif text-base-content/80 mb-6 border-b border-base-content/10 pb-2">
          {roleLabels[role]}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map(async (animal) => {
            const photoKeys = [
              animal.photo ? `/src/assets/images/elevage/${animal.photo}` : null,
              ...(animal.photos ?? []).map(p => `/src/assets/images/elevage/${p}`),
            ].filter((k): k is string => !!k);

            const photoSrcs = (await Promise.all(
              photoKeys.map(async (key) => {
                const mod = photoModules[key];
                return mod ? (await mod()).default : null;
              })
            )).filter((s): s is ImageMetadata => !!s);

            return (
              <article class="card bg-base-100 shadow-sm border border-base-content/5 overflow-hidden flex flex-col" data-animal-card>
                <figure class="relative aspect-square bg-base-200 overflow-hidden">
                  {photoSrcs.length > 0 ? (
                    <>
                      {photoSrcs.map((src, i) => (
                        <div
                          class="carousel-slide absolute inset-0"
                          data-slide={i}
                          style={i > 0 ? 'display:none' : ''}
                        >
                          <Image
                            src={src}
                            alt={`Photo de ${animal.nom}${photoSrcs.length > 1 ? ` (${i + 1}/${photoSrcs.length})` : ''}`}
                            width={400}
                            height={533}
                            class="w-full h-full object-contain"
                          />
                        </div>
                      ))}
                      {photoSrcs.length > 1 && (
                        <>
                          <button
                            data-carousel-prev
                            class="absolute left-2 top-1/2 -translate-y-1/2 btn btn-circle btn-xs bg-base-100/80 hover:bg-base-100 border-0 shadow"
                            aria-label="Photo précédente"
                          >‹</button>
                          <button
                            data-carousel-next
                            class="absolute right-2 top-1/2 -translate-y-1/2 btn btn-circle btn-xs bg-base-100/80 hover:bg-base-100 border-0 shadow"
                            aria-label="Photo suivante"
                          >›</button>
                          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
                            {photoSrcs.map((_, i) => (
                              <div
                                data-dot={i}
                                class={`w-1.5 h-1.5 rounded-full transition-opacity ${i === 0 ? 'bg-white opacity-100' : 'bg-white opacity-40'}`}
                              />
                            ))}
                          </div>
                        </>
                      )}
                    </>
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <svg viewBox="0 0 120 80" class="w-32 h-24 text-base-content/20" fill="currentColor" aria-hidden="true">
                        <path d="M95 18c-2-3-5-5-8-5l-3 1-2-4c-1-2-3-3-5-3h-6c-3 0-5 1-6 3l-4 8-10 4-8 2-8 6-5 8-3 10v10h6v-8l3-8 5-4 8-2 10-4 4-2 2 2v24h6V44l2-4 4-2h4l6 2 4 6v16h6V46l-2-8-3-6 4-7 4-5-1-2z" />
                        <ellipse cx="25" cy="65" rx="12" ry="5" opacity=".3" />
                      </svg>
                    </div>
                  )}
                </figure>

                <div class="card-body p-4 gap-2 flex-1">
                  <h4 class="card-title text-lg font-serif">{animal.nom}</h4>

                  {(animal.race || animal.anneeNaissance) && (
                    <p class="text-sm text-base-content/70">
                      {[animal.race, animal.anneeNaissance ? `né(e) en ${animal.anneeNaissance}` : null]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                  )}

                  {(animal.pere || animal.mere || animal.pereDeMere) && (
                    <dl class="text-sm text-base-content/70 grid grid-cols-[auto_1fr] gap-x-2 gap-y-0.5">
                      {animal.pere && <><dt class="font-medium">Père</dt><dd>{animal.pere}</dd></>}
                      {animal.mere && <><dt class="font-medium">Mère</dt><dd>{animal.mere}</dd></>}
                      {animal.pereDeMere && <><dt class="font-medium">Père de mère</dt><dd>{animal.pereDeMere}</dd></>}
                    </dl>
                  )}

                  <p class="text-sm text-base-content/80 leading-relaxed">{animal.description}</p>

                  {animal.palmares && animal.palmares.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-1">
                      {animal.palmares.map((entry) => (
                        <span class="badge badge-outline badge-sm">{entry}</span>
                      ))}
                    </div>
                  )}
                </div>

                {animal.prixReservation && (
                  <div class="border-t border-base-content/10 bg-base-200/60 px-4 py-3">
                    <p class="text-xs font-semibold text-base-content/75 uppercase tracking-wide mb-2">Tarif saillie</p>
                    <dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 text-sm">
                      <dt class="text-base-content/70">À la réservation</dt>
                      <dd class="font-semibold text-primary text-right">{animal.prixReservation}</dd>
                      {animal.prixPoulainVivant != null && (
                        <>
                          <dt class="text-base-content/70">Solde poulain vivant</dt>
                          <dd class="font-semibold text-primary text-right">{animal.prixPoulainVivant}</dd>
                        </>
                      )}
                    </dl>
                  </div>
                )}

                {!animal.prixReservation && animal.prix && prixLabels[role] && (
                  <div class="border-t border-base-content/10 bg-base-200/60 px-4 py-3">
                    <p class="text-sm font-medium text-primary">{prixLabels[role]} : {animal.prix}</p>
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-animal-card]').forEach((card) => {
    const slides = Array.from(card.querySelectorAll<HTMLElement>('[data-slide]'));
    if (slides.length <= 1) return;

    const dots = Array.from(card.querySelectorAll<HTMLElement>('[data-dot]'));
    let current = 0;

    const show = (index: number) => {
      slides[current].style.display = 'none';
      dots[current]?.classList.replace('opacity-100', 'opacity-40');
      current = ((index % slides.length) + slides.length) % slides.length;
      slides[current].style.display = '';
      dots[current]?.classList.replace('opacity-40', 'opacity-100');
    };

    card.querySelector('[data-carousel-prev]')?.addEventListener('click', () => show(current - 1));
    card.querySelector('[data-carousel-next]')?.addEventListener('click', () => show(current + 1));
  });
</script>
