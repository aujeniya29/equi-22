---
import { business } from '../data/business.ts';
import { mainMenu } from '../data/navigation.ts';
---

<footer class="footer sm:footer-horizontal bg-base-300 text-base-content p-10 pb-16 lg:pb-10">
  <!-- Center Identity Section -->
  <div>
    <span class="footer-title opacity-100">{business.name}</span>
    <p class="text-sm">
      {business.address}<br />
      {business.postalCode} {business.city}
    </p>
    <a
      href={`tel:${business.phone.replace(/\s/g, '')}`}
      class="link link-hover text-sm min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
    >
      {business.phone}
    </a>
    <a
      href={`mailto:${business.email}`}
      class="link link-hover text-sm min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
    >
      {business.email}
    </a>
  </div>

  <!-- Opening Hours Section -->
  <div>
    <span class="footer-title opacity-100">Horaires</span>
    {business.openingHours.map((schedule) => (
      <p class="text-sm">
        <span class="font-medium">{schedule.days}:</span> {schedule.hours}
      </p>
    ))}
  </div>

  <!-- Quick Links Section -->
  <nav aria-label="Navigation rapide">
    <span class="footer-title opacity-100">Navigation</span>
    {mainMenu.map((link) => (
      <a
        href={link.href}
        class="link link-hover text-sm min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Legal & Social Section -->
  <nav aria-label="Mentions légales et réseaux sociaux">
    <span class="footer-title opacity-100">Informations légales</span>
    <a
      href="/mentions-legales"
      class="link link-hover text-sm min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
    >
      Mentions légales
    </a>
    <a
      href="/politique-confidentialite"
      class="link link-hover text-sm min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
    >
      Politique de confidentialité
    </a>

    <span class="footer-title opacity-100 mt-4">Suivez-nous</span>
    <div class="flex gap-3">
      <a
        href={business.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Suivez-nous sur Facebook"
        class="w-11 h-11 rounded-full flex items-center justify-center text-white bg-[#1877F2] hover:brightness-110 motion-safe:transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
          <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
        </svg>
      </a>
      <a
        href={business.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Suivez-nous sur Instagram"
        class="w-11 h-11 rounded-full flex items-center justify-center text-white hover:brightness-110 motion-safe:transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
    </div>
  </nav>
</footer>
