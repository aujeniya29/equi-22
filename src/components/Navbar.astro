---
import { Image } from 'astro:assets';
import logoSrc from '../assets/images/logo.webp';
import { mainMenu, desktopMenu } from '../data/navigation.ts';
import type { NavGroup } from '../data/navigation.ts';
import { business } from '../data/business.ts';

function isGroup(item: unknown): item is NavGroup {
  return typeof item === 'object' && item !== null && 'items' in item;
}

const currentPath = Astro.url.pathname;
---

<nav aria-label="Navigation principale" class="fixed top-0 left-0 right-0 z-50 bg-base-100 shadow-sm">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="hover:opacity-80 motion-safe:transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full" aria-label="Équi 22 — Accueil">
        <span class="inline-flex rounded-full shadow-sm p-2 bg-white">
          <Image src={logoSrc} alt="Logo Équi 22 — Centre équestre Yffiniac" width={200} height={200} class="h-20 lg:h-24 w-auto rounded-full" loading="eager" />
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {desktopMenu.map((item) => (
          isGroup(item) ? (
            <div class="group relative">
              <button
                class:list={[
                  'flex items-center gap-1 text-sm px-3 py-2 rounded-lg motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
                  item.items.some(l => currentPath === l.href || currentPath.startsWith(l.href + '/'))
                    ? 'text-primary font-semibold'
                    : 'text-base-content hover:text-primary hover:bg-base-200',
                ]}
                aria-haspopup="true"
              >
                {item.label}
                <svg class="w-3 h-3 motion-safe:transition-transform motion-safe:duration-200 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <ul class="absolute left-0 top-full mt-1 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 motion-safe:transition-all motion-safe:duration-150 bg-base-100 shadow-xl rounded-xl py-2 min-w-52 z-50 border border-base-200">
                {item.items.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
                        currentPath === link.href || currentPath.startsWith(link.href + '/')
                          ? 'text-primary font-semibold bg-primary/5'
                          : 'text-base-content hover:bg-base-200 hover:text-primary',
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={(item as {href: string}).href}
              class:list={[
                'text-sm px-3 py-2 rounded-lg motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
                currentPath === (item as {href: string}).href || currentPath.startsWith((item as {href: string}).href + '/')
                  ? 'text-primary font-semibold'
                  : 'text-base-content hover:text-primary hover:bg-base-200',
              ]}
            >
              {(item as {label: string}).label}
            </a>
          )
        ))}
      </div>

      <!-- CTA Contact Button (Desktop) -->
      <div class="hidden lg:block">
        <a href="/contact" class="btn btn-secondary">
          Nous contacter
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="menu-button"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        class="lg:hidden w-11 h-11 flex items-center justify-center text-base-content hover:text-primary motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 invisible opacity-0 motion-safe:transition-all motion-safe:duration-300"
    aria-hidden="true"
  >
    <!-- Backdrop -->
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/30"></div>

    <!-- Menu Panel -->
    <div class="absolute inset-y-0 right-0 w-full bg-base-100 translate-x-full motion-safe:transition-transform motion-safe:duration-300" id="mobile-menu-panel">
      <div class="flex flex-col h-full">
        <!-- Mobile Menu Header -->
        <div class="flex items-center justify-between h-20 px-4 border-b border-base-200">
          <a href="/" aria-label="Équi 22 — Accueil">
            <span class="inline-flex rounded-full shadow-sm p-2 bg-white">
              <Image src={logoSrc} alt="Logo Équi 22" width={160} height={160} class="h-16 w-auto rounded-full" loading="eager" />
            </span>
          </a>
          <button
            id="menu-close"
            type="button"
            aria-label="Fermer le menu"
            class="w-11 h-11 flex items-center justify-center text-base-content hover:text-primary motion-safe:transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Mobile Menu Links -->
        <div class="flex-1 overflow-y-auto">
          <div class="flex flex-col py-4">
            {mainMenu.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'px-4 py-4 text-lg motion-safe:transition-colors min-h-[44px] flex items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
                  currentPath === link.href || currentPath.startsWith(link.href + '/')
                    ? 'text-primary font-semibold bg-base-200'
                    : 'text-base-content hover:bg-base-200 hover:text-primary',
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Social Icons (Mobile) -->
        <div class="px-4 py-5 border-t border-base-200 flex gap-3">
          <a
            href={business.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suivez-nous sur Facebook"
            class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium text-white bg-[#1877F2] hover:brightness-110 motion-safe:transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
            Facebook
          </a>
          <a
            href={business.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suivez-nous sur Instagram"
            class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium text-white hover:brightness-110 motion-safe:transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            Instagram
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('menu-button');
  const closeButton = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuPanel = document.getElementById('mobile-menu-panel');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  // Focus trap: collect focusable elements within the menu panel
  function getFocusableElements(): HTMLElement[] {
    if (!menuPanel) return [];
    return Array.from(
      menuPanel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function openMenu() {
    if (!mobileMenu || !menuPanel) return;
    mobileMenu.classList.remove('invisible', 'opacity-0');
    mobileMenu.setAttribute('aria-hidden', 'false');
    menuPanel.classList.remove('translate-x-full');
    menuPanel.classList.add('translate-x-0');
    menuButton?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Focus the close button when menu opens
    closeButton?.focus();
  }

  function closeMenu() {
    if (!mobileMenu || !menuPanel) return;
    menuPanel.classList.remove('translate-x-0');
    menuPanel.classList.add('translate-x-full');
    mobileMenu.classList.add('opacity-0');
    // Wait for transition to finish before hiding
    const handleTransitionEnd = () => {
      mobileMenu.classList.add('invisible');
      mobileMenu.setAttribute('aria-hidden', 'true');
      menuPanel.removeEventListener('transitionend', handleTransitionEnd);
    };
    menuPanel.addEventListener('transitionend', handleTransitionEnd);
    // Fallback in case transitionend doesn't fire (prefers-reduced-motion)
    setTimeout(() => {
      mobileMenu.classList.add('invisible');
      mobileMenu.setAttribute('aria-hidden', 'true');
    }, 350);
    menuButton?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    // Return focus to hamburger button
    menuButton?.focus();
  }

  menuButton?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);

  // Close menu when clicking on a link
  menuPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu when clicking on backdrop
  backdrop?.addEventListener('click', closeMenu);

  // Close menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('invisible')) {
      closeMenu();
    }
  });

  // Focus trap within mobile menu
  mobileMenu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = getFocusableElements();
    if (focusable.length === 0) return;

    const firstEl = focusable[0];
    const lastEl = focusable[focusable.length - 1];

    if (e.shiftKey) {
      if (document.activeElement === firstEl) {
        e.preventDefault();
        lastEl.focus();
      }
    } else {
      if (document.activeElement === lastEl) {
        e.preventDefault();
        firstEl.focus();
      }
    }
  });
</script>
