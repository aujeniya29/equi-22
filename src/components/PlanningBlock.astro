---
interface ScheduleItem {
  day: string;
  time: string;
  level?: string;
}

interface TimeGroup {
  time: string;
  slots: ScheduleItem[];
}

interface Props {
  schedule: ScheduleItem[];
  bgClass?: string;
  notes?: string[];
}

const { schedule, bgClass = 'bg-base-100', notes } = Astro.props;
const hasLevels = schedule.some((s) => s.level);

// Group by day, then by time — slots sharing the same day+time are parallel
const days = [...new Set(schedule.map((s) => s.day))];
const grouped = days.reduce((acc, day) => {
  const daySlots = schedule.filter((s) => s.day === day);
  const times = [...new Set(daySlots.map((s) => s.time))];
  acc[day] = times.map((time) => ({
    time,
    slots: daySlots.filter((s) => s.time === time),
  }));
  return acc;
}, {} as Record<string, TimeGroup[]>);
---

{schedule && schedule.length > 0 && (
  <section class={`py-12 lg:py-16 ${bgClass}`}>
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-8">Planning</h2>

      <!-- Desktop table -->
      <div class="hidden lg:block overflow-x-auto">
        <table class="table table-lg">
          <caption class="sr-only">Tableau du planning hebdomadaire</caption>
          <thead>
            <tr>
              <th>Jour</th>
              <th>Horaire</th>
              {hasLevels && <th>Niveau</th>}
            </tr>
          </thead>
          <tbody>
            {days.map((day) =>
              grouped[day].map((group, i) => (
                <tr class={i === 0 ? 'border-t border-base-300' : ''}>
                  {i === 0 && (
                    <td rowspan={grouped[day].length} class="font-semibold text-primary align-top pt-4">
                      {day}
                    </td>
                  )}
                  <td class="tabular-nums">{group.time}</td>
                  {hasLevels && (
                    <td>
                      <div class="flex flex-wrap items-center gap-2">
                        {group.slots.map((slot) => (
                          <span class="badge badge-outline">{slot.level}</span>
                        ))}
                        {group.slots.length > 1 && (
                          <span class="text-xs text-base-content/50 italic">en parallèle</span>
                        )}
                      </div>
                    </td>
                  )}
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- Mobile : une section par jour -->
      <div class="lg:hidden space-y-6">
        {days.map((day) => (
          <div>
            <h3 class="font-semibold text-primary mb-3">{day}</h3>
            <div class="space-y-2 pl-4 border-l-2 border-primary/30">
              {grouped[day].map((group) => (
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm text-base-content/80 tabular-nums">{group.time}</span>
                  {group.slots.map((slot) => slot.level && (
                    <span class="badge badge-outline">{slot.level}</span>
                  ))}
                  {group.slots.length > 1 && (
                    <span class="text-xs text-base-content/50 italic">en parallèle</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {notes && notes.length > 0 && (
        <ul class="mt-6 space-y-1">
          {notes.map((note) => (
            <li class="text-sm text-base-content/70 flex gap-2">
              <span aria-hidden="true">—</span>
              <span>{note}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
