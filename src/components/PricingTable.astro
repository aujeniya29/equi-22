---
interface PricingRow {
  label: string;
  price: string;
  unit: string;
  highlight: boolean;
}

interface PricingGroup {
  title: string;
  subtitle?: string;
  items: PricingRow[];
  notes?: string[];
  highlightedNotes?: string[];
}

interface Props {
  pricing?: PricingRow[];
  pricingGroups?: PricingGroup[];
  pricingNotes?: string[];
  bgClass?: string;
}

const { pricing, pricingGroups, pricingNotes, bgClass = 'bg-base-200' } = Astro.props;
---

<section class={`py-12 lg:py-16 ${bgClass}`}>
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-8">Tarifs</h2>

    {pricingGroups && pricingGroups.length > 0 ? (
      /* Grouped pricing */
      <div class="space-y-10">
        {pricingGroups.map((group) => (
          <div>
            <div class="mb-4 border-b border-base-content/15 pb-2">
              <h3 class="text-lg font-semibold text-base-content">{group.title}</h3>
              {group.subtitle && (
                <p class="text-sm text-base-content/60 mt-0.5">{group.subtitle}</p>
              )}
            </div>

            {/* Desktop table */}
            <div class="hidden lg:block overflow-x-auto">
              <table class="table">
                <caption class="sr-only">{group.title}</caption>
                <thead>
                  <tr>
                    <th>Formule</th>
                    <th>Tarif</th>
                    <th>Unité</th>
                  </tr>
                </thead>
                <tbody>
                  {group.items.map((row) => (
                    <tr class={row.highlight ? 'bg-primary/5 border-l-4 border-primary' : ''}>
                      <td class="font-medium">
                        {row.label}
                        {row.highlight && <span class="badge badge-primary badge-sm ml-2">Meilleure offre</span>}
                      </td>
                      <td class="text-lg font-bold">{row.price}€</td>
                      <td class="text-base-content/60">/{row.unit}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Mobile stacked cards */}
            <div class="lg:hidden space-y-3">
              {group.items.map((row) => (
                <div class={`card bg-base-100 shadow-sm p-4 ${row.highlight ? 'border-2 border-primary' : ''}`}>
                  <div class="flex justify-between items-center">
                    <div>
                      <p class="font-medium">{row.label}</p>
                      {row.highlight && <span class="badge badge-primary badge-sm mt-1">Meilleure offre</span>}
                    </div>
                    <div class="text-right">
                      <p class="text-xl font-bold">{row.price}€</p>
                      <p class="text-sm text-base-content/60">/{row.unit}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            {/* Per-group highlighted notes */}
            {group.highlightedNotes && group.highlightedNotes.length > 0 && (
              <ul class="mt-4 space-y-2">
                {group.highlightedNotes.map((note) => (
                  <li class="flex items-start gap-2 border-l-2 border-primary bg-primary/5 px-3 py-2 rounded-r text-sm font-medium text-base-content">
                    <svg class="w-4 h-4 mt-0.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                    {note}
                  </li>
                ))}
              </ul>
            )}

            {/* Per-group notes */}
            {group.notes && group.notes.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm text-base-content/70">
                {group.notes.map((note) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 mt-0.5 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {note}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    ) : pricing && pricing.length > 0 ? (
      /* Flat pricing */
      <div>
        {/* Desktop table */}
        <div class="hidden lg:block overflow-x-auto">
          <table class="table">
            <caption class="sr-only">Tableau des tarifs</caption>
            <thead>
              <tr>
                <th>Formule</th>
                <th>Tarif</th>
                <th>Unité</th>
              </tr>
            </thead>
            <tbody>
              {pricing.map((row) => (
                <tr class={row.highlight ? 'bg-primary/5 border-l-4 border-primary' : ''}>
                  <td class="font-medium">
                    {row.label}
                    {row.highlight && <span class="badge badge-primary badge-sm ml-2">Meilleure offre</span>}
                  </td>
                  <td class="text-lg font-bold">{row.price}€</td>
                  <td class="text-base-content/60">/{row.unit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Mobile stacked cards */}
        <div class="lg:hidden space-y-3">
          {pricing.map((row) => (
            <div class={`card bg-base-100 shadow-sm p-4 ${row.highlight ? 'border-2 border-primary' : ''}`}>
              <div class="flex justify-between items-center">
                <div>
                  <p class="font-medium">{row.label}</p>
                  {row.highlight && <span class="badge badge-primary badge-sm mt-1">Meilleure offre</span>}
                </div>
                <div class="text-right">
                  <p class="text-xl font-bold">{row.price}€</p>
                  <p class="text-sm text-base-content/60">/{row.unit}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : null}

    {pricingNotes && pricingNotes.length > 0 && (
      <ul class="mt-6 space-y-1 text-sm text-base-content/70">
        {pricingNotes.map((note) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {note}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
