---
import { business } from '../data/business.ts';

interface Props {
  serviceType?: string;
  serviceDescription?: string;
  serviceName?: string;
}

const { serviceType, serviceDescription, serviceName } = Astro.props;

const dayMapping: Record<string, string[]> = {
  'Lundi - Vendredi': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  'Samedi': ['Saturday'],
  'Dimanche': ['Sunday'],
};

// « 8h00 » → « 08:00 » : le type Time de Schema.org suit XSD et exige une heure
// sur 2 chiffres. « 8:00 » est invalide et était émis sur toutes les pages.
const toIsoTime = (t: string) => t.replace('h', ':').padStart(5, '0');

const openingHoursSpecification = business.openingHours
  .filter((entry) => entry.hours !== 'Fermé')
  .map((entry) => {
    const [opens, closes] = entry.hours.split(' - ').map(toIsoTime);
    return {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: dayMapping[entry.days] || [],
      opens,
      closes,
    };
  });

// Pas de fallback : un domaine erroné ici corromprait silencieusement toutes les
// URLs absolues du JSON-LD (url, image, logo). Mieux vaut casser le build.
if (!Astro.site) {
  throw new Error(
    'Astro.site non configuré — définir `site` dans astro.config.mjs avant de builder.'
  );
}
const siteUrl = Astro.site.href;

// Identifiant unique de l'entité : les autres blocs (Service, BlogPosting) le
// référencent au lieu de redéclarer un nœud anonyme, sinon rien n'indique aux
// moteurs qu'il s'agit du même établissement.
const ORG_ID = `${siteUrl}#organization`;

// Zone desservie réelle : l'adresse est à Yffiniac, la clientèle vient du
// bassin de Saint-Brieuc. Déclaré une fois, réutilisé par les Service.
const areaServed = [
  { '@type': 'City', name: business.city },
  { '@type': 'City', name: 'Saint-Brieuc' },
  { '@type': 'AdministrativeArea', name: "Côtes-d'Armor" },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['SportsClub', 'LocalBusiness'],
  '@id': ORG_ID,
  name: business.name,
  url: siteUrl,
  image: new URL('/og-default.jpg', siteUrl).href,
  logo: new URL('/logo.png', siteUrl).href,
  priceRange: '€€',
  telephone: business.phone,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address,
    addressLocality: business.city,
    postalCode: business.postalCode,
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.gps.latitude,
    longitude: business.gps.longitude,
  },
  openingHoursSpecification,
  areaServed,
  hasMap: business.googleReviews.googleBusinessUrl,
  sameAs: [business.social.facebook, business.social.instagram],
};

let serviceSchema: Record<string, unknown> | null = null;
if (serviceType && serviceDescription) {
  // Seul `EducationalOccupationalProgram` est un @type Schema.org à part entière.
  // Pour tout le reste, `serviceType` est une propriété *texte* de Service
  // (« le type de prestation proposée ») — pas un @type. L'utiliser comme `name`
  // faisait sortir « AnimalService » / « EducationalService » dans un champ censé
  // être lisible par un humain.
  const isProgram = serviceType === 'EducationalOccupationalProgram';
  // Même normalisation que le canonical de BaseLayout : `build.format: 'file'`
  // fait apparaître un `.html` dans Astro.url.pathname, qui ne doit jamais
  // ressortir dans une URL publique.
  const pageUrl = new URL(
    Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/',
    siteUrl
  ).href;

  serviceSchema = {
    '@context': 'https://schema.org',
    '@type': isProgram ? 'EducationalOccupationalProgram' : 'Service',
    '@id': `${pageUrl}#service`,
    name: serviceName || serviceType,
    description: serviceDescription,
    url: pageUrl,
    provider: { '@id': ORG_ID },
    ...(isProgram ? {} : { serviceType, areaServed }),
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
{serviceSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
)}
