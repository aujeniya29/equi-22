---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import PlanningBlock from './PlanningBlock.astro';
import PricingTable from './PricingTable.astro';
import Testimonial from './Testimonial.astro';
import GoogleReviews from './GoogleReviews.astro';
import BreedingAnimals from './BreedingAnimals.astro';
import DocumentLinks from './DocumentLinks.astro';
import { getCategoriesBySlug } from '../data/documents';
import { business } from '../data/business';

interface Props {
  entry: CollectionEntry<'services'>;
  heroImage?: ImageMetadata;
}

const { entry, heroImage } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const phoneUrl = `tel:${business.phone.replace(/\s/g, '')}`;
const whatsappNumber = business.whatsapp.replace(/[^\d]/g, '');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(data.whatsappMessage)}`;

// Compute alternating backgrounds based on which sections are actually present,
// so the rhythm holds even when planning or testimonial are absent.
const hasSchedule = !!(data.schedule && data.schedule.length > 0);
const hasPricing = !!(data.pricing && data.pricing.length > 0) || !!(data.pricingGroups && data.pricingGroups.length > 0);
const hasAnimals = !!(data.animals && data.animals.length > 0);
const hasDocuments = !!(data.documents && data.documents.length > 0);
const hasTestimonial = !!data.testimonial;
const documentCategories = hasDocuments ? getCategoriesBySlug(data.documents!) : [];
const planningAfterPricing = data.planningAfterPricing ?? false;

const BG = ['bg-base-200', 'bg-base-100'] as const;
let idx = 0;
const proseBg = BG[idx++ % 2]; // always bg-base-200
let planningBg: string;
let pricingBg: string;
if (planningAfterPricing) {
  pricingBg = BG[idx % 2];
  if (hasPricing) idx++;
  planningBg = BG[idx % 2];
  if (hasSchedule) idx++;
} else {
  planningBg = BG[idx % 2];
  if (hasSchedule) idx++;
  pricingBg = BG[idx % 2];
  if (hasPricing) idx++;
}
const animalsBg    = BG[idx % 2];
if (hasAnimals) idx++;
const documentsBg  = BG[idx % 2];
if (hasDocuments) idx++;
const testimonialBg = BG[idx % 2];
if (hasTestimonial) idx++;
const reviewsBg    = BG[idx % 2]; // GoogleReviews always renders — must participate in alternation
idx++;
const ctaBg        = BG[idx % 2];
---

<BaseLayout
  title={data.seoTitle}
  description={data.seoDescription}
  ogImage={data.ogImage}
  serviceType={data.serviceType}
  serviceDescription={data.serviceDescription}
  whatsappMessage={data.whatsappMessage}
>
  <!-- Hero Section -->
  <Hero
    title={data.title}
    description={data.description}
    imageSrc={heroImage}
    imageAlt={data.heroImageAlt}
  />

  <!-- Promise / Narrative Content (from Markdown body) -->
  <section class={`py-12 lg:py-16 ${proseBg}`}>
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </section>

  <!-- Planning / Pricing (order controlled by planningAfterPricing) -->
  {planningAfterPricing ? (
    <Fragment>
      {hasPricing && (
        <PricingTable pricing={data.pricing} pricingGroups={data.pricingGroups} pricingNotes={data.pricingNotes} bgClass={pricingBg} />
      )}
      {hasSchedule && (
        <PlanningBlock schedule={data.schedule!} bgClass={planningBg} notes={data.scheduleNotes} />
      )}
    </Fragment>
  ) : (
    <Fragment>
      {hasSchedule && (
        <PlanningBlock schedule={data.schedule!} bgClass={planningBg} notes={data.scheduleNotes} />
      )}
      {hasPricing && (
        <PricingTable pricing={data.pricing} pricingGroups={data.pricingGroups} pricingNotes={data.pricingNotes} bgClass={pricingBg} />
      )}
    </Fragment>
  )}

  <!-- Animals Section (conditional, élevage only) -->
  {hasAnimals && (
    <BreedingAnimals animals={data.animals!} bgClass={animalsBg} />
  )}

  <!-- Documents Section (conditional) -->
  {hasDocuments && (
    <DocumentLinks categories={documentCategories} bgClass={documentsBg} />
  )}

  <!-- Testimonial Section (conditional) -->
  {hasTestimonial && (
    <Testimonial
      quote={data.testimonial!.quote}
      author={data.testimonial!.author}
      stars={data.testimonial!.stars}
      bgClass={testimonialBg}
    />
  )}

  <!-- Google reviews badge — trust signal near testimonial -->
  <div class={`flex justify-center py-8 ${reviewsBg}`}>
    <GoogleReviews />
  </div>

  <!-- CTA Section -->
  <section class={`py-12 lg:py-16 ${ctaBg}`}>
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">
        Envie d'en savoir plus sur nos {data.title.toLowerCase()} ?
      </h2>
      <p class="text-base-content/70 mb-8 max-w-xl mx-auto">
        Appelez-nous ou envoyez un message WhatsApp pour toute question.
        On vous répond avec plaisir !
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={phoneUrl}
          class="btn btn-primary btn-lg min-h-[44px]"
          aria-label="Appeler le centre équestre"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Appeler
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg min-h-[44px] text-gray-900 bg-[#25D366] border-[#25D366] hover:brightness-110"
          aria-label="Envoyer un message WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
