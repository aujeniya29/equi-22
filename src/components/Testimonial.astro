---
interface Props {
  quote: string;
  author: string;
  stars: number;
  bgClass?: string;
}

const { quote, author, stars, bgClass = 'bg-base-100' } = Astro.props;
---

<section class={`py-12 lg:py-16 ${bgClass}`}>
  <div class="max-w-4xl mx-auto px-4">
    <blockquote class="border-l-4 border-secondary pl-6 py-4">
      <div role="img" class="flex gap-1 mb-3" aria-label={`${stars} étoiles sur 5`}>
        {Array.from({ length: 5 }).map((_, i) => (
          <svg
            class={`w-5 h-5 fill-current ${i < stars ? 'text-yellow-400' : 'text-base-300'}`}
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p class="text-lg italic text-base-content/80 mb-3">"{quote}"</p>
      <cite class="not-italic text-sm font-medium text-base-content/60">— {author}</cite>
    </blockquote>
  </div>
</section>
