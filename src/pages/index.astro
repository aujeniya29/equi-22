---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProfileRouting from '../components/ProfileRouting.astro';
import ServiceCard from '../components/ServiceCard.astro';
import homepageHero from '../assets/images/hero/banniere-accueil.webp';
import GoogleReviews from '../components/GoogleReviews.astro';
import PortesOuvertesBanner from '../components/PortesOuvertesBanner.astro';
import { business } from '../data/business';

const whatsappMessage = "Bonjour, je suis intéressé(e) par les activités du centre équestre Équi 22.";

const allServices = await getCollection('services');
const services = [...allServices].sort((a, b) => a.data.order - b.data.order);

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}'
);

const serviceImages = await Promise.all(
  services.map(async (service) => {
    const imageModule = images[service.data.heroImage];
    if (!imageModule) {
      throw new Error(`Hero image not found: ${service.data.heroImage}`);
    }
    return (await imageModule()).default;
  })
);

const allBlogPosts = await getCollection('actualites');
const recentPosts = [...allBlogPosts]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Accueil"
  description="Centre équestre à Yffiniac, Côtes-d'Armor. Cours enfants et adultes, pension chevaux, stages et compétitions. Découvrez Équi 22."
  whatsappMessage={whatsappMessage}
>
  <Hero
    title="Vivez l'équitation en Bretagne"
    description="Cours pour enfants, adultes, pension chevaux et stages — au cœur des Côtes-d'Armor."
    imageSrc={homepageHero}
    imageAlt="Trois cavalières sur la plage en Bretagne avec les chevaux du centre équestre Equi 22"
    heightClass="min-h-[450px] lg:min-h-[600px]"
  >
    <ProfileRouting />
  </Hero>

  <PortesOuvertesBanner />

  <!-- Google reviews trust signal — between hero and service cards -->
  <section aria-label="Avis Google" class="flex justify-center py-6 bg-base-100">
    <GoogleReviews />
  </section>

  <!-- SEO intro — presents the club, its location and activities with internal links -->
  <section class="pb-12 bg-base-100" aria-labelledby="intro-heading">
    <div class="max-w-4xl mx-auto px-4">
      <h2 id="intro-heading" class="text-2xl lg:text-3xl font-serif text-center mb-6">
        Votre centre équestre à Yffiniac, aux portes de Saint-Brieuc
      </h2>
      <div class="space-y-4 text-base-content/80 text-lg leading-relaxed">
        <p>
          Situé à Yffiniac, dans les Côtes-d'Armor, <strong>Équi 22</strong> est un centre équestre
          familial installé au cœur de la baie de Saint-Brieuc. À quelques minutes de Saint-Brieuc,
          Langueux et Trégueux, le club accueille toute l'année des cavaliers débutants comme
          confirmés, des plus jeunes aux adultes, dans un cadre naturel breton entre prés, chemins
          de randonnée et bord de mer.
        </p>
        <p>
          Nos activités répondent à toutes les envies :
          <a href="/cours-enfants" class="text-primary font-medium hover:underline">cours d'équitation pour enfants et poney</a>,
          <a href="/equitation-adulte" class="text-primary font-medium hover:underline">cours pour adultes</a>,
          <a href="/pension-chevaux" class="text-primary font-medium hover:underline">pension pour chevaux</a>,
          <a href="/balades" class="text-primary font-medium hover:underline">balades à cheval</a>,
          <a href="/stages-vacances" class="text-primary font-medium hover:underline">stages pendant les vacances scolaires</a> et
          <a href="/competitions" class="text-primary font-medium hover:underline">compétitions</a>.
          Nous proposons également des séances de
          <a href="/mountain-trail-ethologie" class="text-primary font-medium hover:underline">mountain trail et d'éthologie</a>
          pour construire une relation différente avec le cheval.
        </p>
        <p>
          Forte de plus de 20 ans d'expérience, notre équipe de monitrices diplômées (BPJEPS,
          formations d'éthologie Andy Booth) partage la même conviction : une équitation
          <strong>bienveillante</strong>, respectueuse du cheval, où chacun progresse à son rythme,
          sans pression ni jugement. Une approche qui nous vaut la confiance de nombreuses familles.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-base-200" aria-labelledby="services-heading">
    <div class="max-w-5xl mx-auto px-4">
      <h2 id="services-heading" class="text-2xl lg:text-3xl font-serif text-center mb-8">Nos services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, index) => (
          <ServiceCard service={service} heroImageSrc={serviceImages[index]} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-10 bg-base-100">
    <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="font-serif text-lg text-base-content">Prêt(e) à vous inscrire ?</p>
        <p class="text-sm text-base-content/70 mt-1">Téléchargez notre fiche d'inscription et remettez-la nous lors de votre première venue.</p>
      </div>
      <a
        href="/documents/fiche_inscription.pdf"
        download="fiche_inscription.pdf"
        class="btn btn-primary shrink-0"
        aria-label="Télécharger la fiche d'inscription"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        Fiche d'inscription
      </a>
    </div>
  </section>

  <section class="py-10 bg-base-200">
    <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="font-serif text-lg text-base-content">L'Association des Cavaliers (ACE)</p>
        <p class="text-sm text-base-content/70 mt-1">L'ACE rassemble les cavaliers et les familles du centre autour de la vie associative du club : sorties, événements, échanges. Adhérer, c'est s'impliquer dans la communauté équestre d'Équi 22 et contribuer à son dynamisme.</p>
      </div>
      <a
        href="/documents/bulletin_adhesion_ACE22.pdf"
        download="bulletin_adhesion_ACE22.pdf"
        class="btn btn-outline shrink-0"
        aria-label="Télécharger le bulletin d'adhésion ACE"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        Bulletin d'adhésion
      </a>
    </div>
  </section>

  <section class="py-12 bg-base-100" aria-labelledby="news-heading">
    <div class="max-w-5xl mx-auto px-4">
      <h2 id="news-heading" class="text-2xl lg:text-3xl font-serif text-center mb-8">Actualités</h2>
      {recentPosts.length > 0 ? (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {recentPosts.map((post) => {
              const formattedDate = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(post.data.date);
              const displayDate = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);
              return (
                <article class="bg-base-100 rounded-2xl border border-base-200 p-6 flex flex-col gap-3 shadow-sm">
                  <time datetime={post.data.date.toISOString()} class="text-xs font-medium text-base-content/75 tracking-wide">
                    {displayDate}
                  </time>
                  <h3 class="font-serif text-base text-base-content leading-snug">{post.data.title}</h3>
                  <p class="text-sm text-base-content/70 leading-relaxed flex-1">{post.data.excerpt}</p>
                  <a
                    href={`/actualites/${post.id}`}
                    aria-label={`Lire l'article : ${post.data.title}`}
                    class="text-sm text-primary font-semibold hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded self-start"
                  >
                    Lire l'article →
                  </a>
                </article>
              );
            })}
          </div>
          <div class="mt-8 text-center">
            <a href="/actualites" class="btn btn-outline">Voir toutes les actualités</a>
          </div>
        </>
      ) : (
        <p class="text-base-content/70 text-center py-6">Les prochaines actualités du club arrivent bientôt.</p>
      )}

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={business.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium text-white bg-[#1458B8] hover:brightness-110 motion-safe:transition-all"
        >
          <svg style="width:1em;height:1em" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          Suivez-nous sur Facebook
        </a>
        <a
          href={business.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-medium text-white hover:brightness-110 motion-safe:transition-all"
          style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%)"
        >
          <svg style="width:1em;height:1em" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          Suivez-nous sur Instagram
        </a>
      </div>
    </div>
  </section>

  <!-- Closing SEO / conversion block -->
  <section class="py-12 lg:py-16 bg-base-200" aria-labelledby="closing-heading">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 id="closing-heading" class="text-2xl lg:text-3xl font-serif mb-4">
        Prêt(e) à monter en selle ?
      </h2>
      <p class="text-base-content/80 text-lg leading-relaxed max-w-2xl mx-auto">
        Que vous souhaitiez offrir un premier cours de poney à votre enfant, reprendre l'équitation
        ou trouver une pension de qualité pour votre cheval, l'équipe d'Équi 22 vous
        accueille à Yffiniac. Venez découvrir nos installations, échanger sur votre projet équestre
        et, pourquoi pas, réserver un premier cours d'essai — tout commence par une simple prise de
        contact.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn btn-primary min-h-[44px]">Nous contacter</a>
        <a href="/a-propos" class="btn btn-outline min-h-[44px]">Découvrir le club</a>
      </div>
    </div>
  </section>
</BaseLayout>
