---
import { Picture, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { business } from '../data/business';

import aurelia from '../assets/images/team/aurelia.jpg';

import heroImage from '../assets/images/loisirs/ethologie2.jpg';
import mountaintrail1 from '../assets/images/loisirs/mountaintrail1.jpg';
import mountaintrail2 from '../assets/images/loisirs/mountaintrail2.webp';
import mountaintrail3 from '../assets/images/loisirs/mountaintrail3.webp';
import ethologie1 from '../assets/images/loisirs/ethologie1.jpg';
import ethologie2 from '../assets/images/loisirs/ethologie2.jpg';
import ethologie3 from '../assets/images/loisirs/ethologie3.jpg';

const whatsappNumber = business.whatsapp.replace(/[^\d]/g, '');
const whatsappMessage = "Bonjour, je suis intéressé(e) par vos activités loisirs (mountain trail, éthologie). Pourriez-vous me donner plus d'informations ?";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const mountainTrailPhotos = [
  { src: mountaintrail1, alt: 'Parcours de mountain trail au centre équestre Équi 22 à Yffiniac' },
  { src: mountaintrail2, alt: 'Cheval franchissant un obstacle de mountain trail à Yffiniac' },
  { src: mountaintrail3, alt: 'Mountain trail en extérieur au centre équestre Équi 22' },
];

const ethologiePhotos = [
  { src: ethologie1, alt: 'Travail en éthologie équestre au centre Équi 22 à Yffiniac' },
  { src: ethologie2, alt: 'Communication cheval-cavalier en éthologie à Équi 22' },
  { src: ethologie3, alt: 'Séance d\'éthologie équestre au centre équestre Équi 22' },
];
---

<BaseLayout
  title="Mountain Trail & Éthologie équestre à Yffiniac"
  description="Découvrez le mountain trail et l'éthologie équestre à Équi 22, centre équestre à Yffiniac près de Saint-Brieuc. Des disciplines loisirs pour approfondir la relation avec votre cheval."
  whatsappMessage={whatsappMessage}
>
  <Hero
    title="Mountain Trail & Éthologie"
    description="Des disciplines qui mettent la relation au centre — pour progresser autrement, en prenant le temps de comprendre votre cheval."
    imageSrc={heroImage}
    imageAlt="Éthologie équestre au centre équestre Équi 22 à Yffiniac"
  />

  <!-- Intro -->
  <section class="py-12 lg:py-16 bg-base-100">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-lg text-base-content/80 leading-relaxed">
        À Équi 22, l'équitation loisirs ne se résume pas à la carrière ou au manège. Le mountain trail et l'éthologie sont deux disciplines complémentaires qui permettent d'aller plus loin dans la relation avec son cheval — en dehors des sentiers battus, et sans jamais forcer.
      </p>
    </div>
  </section>

  <!-- Mountain Trail -->
  <section class="py-12 lg:py-16 bg-base-200">
    <div class="max-w-5xl mx-auto px-4">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">Mountain Trail</h2>
        <p class="text-base-content/80 leading-relaxed mb-4">
          Le mountain trail est une discipline qui simule les conditions de la randonnée en nature : ponts à traverser, portes à ouvrir, franchissements d'eau, montées et descentes, obstacles à contourner. L'objectif n'est pas la vitesse, mais la <strong>confiance et la franchise</strong> — du cheval face aux obstacles, et du cavalier dans ses aides.
        </p>
        <p class="text-base-content/80 leading-relaxed mb-4">
          Accessible dès les premiers galops, c'est une activité ludique qui sort de la routine et renforce la complicité avec sa monture. Les parcours sont progressifs : chaque obstacle peut être abordé à pied ou à cheval, à son propre rythme.
        </p>
        <p class="text-base-content/80 leading-relaxed">
          Équi 22 dispose d'un <strong>parcours de mountain trail</strong> en extérieur, praticable toute l'année. Idéal pour varier les entraînements, préparer une compétition, ou simplement passer un bon moment avec son cheval.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {mountainTrailPhotos.map(({ src, alt }) => (
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-base-300">
            <Picture
              src={src}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              alt={alt}
              widths={[400, 800]}
              sizes="(min-width: 640px) 33vw, 100vw"
              class="w-full h-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Éthologie -->
  <section class="py-12 lg:py-16 bg-base-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">Éthologie équestre</h2>
        <p class="text-base-content/80 leading-relaxed mb-4">
          L'éthologie équestre s'appuie sur la compréhension du comportement naturel du cheval pour établir une communication authentique. Le principe est simple : <strong>convaincre plutôt que contraindre</strong>. Le travail au sol est au cœur de la démarche — avant même de monter, on apprend à lire les signaux du cheval et à s'exprimer dans son langage.
        </p>
        <p class="text-base-content/80 leading-relaxed mb-4">
          Cette approche transforme la relation : le cavalier devient un guide en qui le cheval a confiance, et non une autorité à subir. Les progrès sont visibles rapidement — en termes de calme, d'écoute et de disponibilité du cheval au travail.
        </p>
        <p class="text-base-content/80 leading-relaxed">
          À Équi 22, l'éthologie s'intègre naturellement à nos pratiques quotidiennes. Elle bénéficie à tous — débutants qui veulent poser de bonnes bases, cavaliers confirmés qui souhaitent affiner leur communication, ou propriétaires en pension qui veulent mieux comprendre leur cheval.
        </p>

        <div class="mt-8 bg-base-200 rounded-2xl p-6 flex flex-col sm:flex-row gap-6 items-center sm:items-start">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden flex-shrink-0 ring-4 ring-secondary/30">
            <Image
              src={aurelia}
              alt="Aurélia, gérante et monitrice du centre équestre Équi 22"
              width={112}
              height={112}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
              <span class="font-serif text-lg text-base-content">Aurélia</span>
              <span class="text-xs font-semibold text-primary uppercase tracking-wide">Gérante &amp; Monitrice</span>
            </div>
            <p class="text-base-content/70 text-sm leading-relaxed mb-3">
              Passionnée d'éthologie, Aurélia a suivi <strong>3 ans de formation avec Andy Booth</strong> — figure de référence de l'éthologie équestre en France — pour obtenir successivement le BFEE 1 puis le BFEE 2. C'est cette expertise qu'elle transmet au quotidien, dans le respect du cheval et des cavaliers.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-block text-xs font-medium bg-primary/10 text-primary px-2.5 py-1 rounded-full">BFEE 1 — Éthologie équestre</span>
              <span class="inline-block text-xs font-medium bg-primary/10 text-primary px-2.5 py-1 rounded-full">BFEE 2 — Éthologie équestre</span>
              <span class="inline-block text-xs font-medium bg-secondary/10 text-secondary px-2.5 py-1 rounded-full">Formation Andy Booth · 3 ans</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-10">
        {ethologiePhotos.map(({ src, alt }) => (
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-base-300">
            <Picture
              src={src}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              alt={alt}
              widths={[400, 800]}
              sizes="(min-width: 640px) 33vw, 100vw"
              class="w-full h-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 lg:py-16 bg-base-200">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">
        Une question ? Envie d'essayer ?
      </h2>
      <p class="text-base-content/70 mb-8 max-w-xl mx-auto">
        Contactez-nous pour en savoir plus sur nos activités loisirs ou organiser une première séance.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:${business.phone.replace(/\s/g, '')}`}
          class="btn btn-primary btn-lg min-h-[44px]"
          aria-label="Appeler le centre équestre"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Appeler
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg min-h-[44px] text-gray-900 bg-[#25D366] border-[#25D366] hover:brightness-110"
          aria-label="Envoyer un message WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
