---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorseGallery from '../../components/HorseGallery.astro';
import { business } from '../../data/business';

export async function getStaticPaths() {
  const horses = await getCollection('vente');
  return horses.map((horse) => ({
    params: { slug: horse.id },
    props: { entry: horse },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const {
  title, espece, race, anneeNaissance, sexe, taille, robe,
  niveau, disciplines, prix, vendu, photoPrincipale, photos,
  seoTitle, seoDescription,
} = data;

const age = new Date().getFullYear() - anneeNaissance;
const ageLabel = age <= 1 ? `${age} an` : `${age} ans`;
const sexeLabels: Record<string, string> = { hongre: 'Hongre', jument: 'Jument', etalon: 'Étalon' };

// Resolve all photos for this horse
const allVenteImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/vente/**/*.{jpg,jpeg,png,webp}'
);

const allPhotoFilenames = [
  ...(photoPrincipale ? [photoPrincipale] : []),
  ...(photos ?? []),
];

const resolvedImages: ImageMetadata[] = [];
for (const filename of allPhotoFilenames) {
  const key = `/src/assets/images/vente/${entry.id}/${filename}`;
  const mod = allVenteImages[key];
  if (mod) {
    const { default: img } = await mod();
    resolvedImages.push(img);
  }
}

// WhatsApp message pre-filled with horse name
const whatsappNumber = business.whatsapp.replace(/[^\d]/g, '');
const whatsappMessage = `Bonjour, je suis intéressé(e) par ${title} (${race}, ${prix}). Pourriez-vous me donner plus d'informations et convenir d'une visite ?`;
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const phoneUrl = `tel:${business.phone.replace(/\s/g, '')}`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  whatsappMessage={whatsappMessage}
>
  <!-- Header -->
  <section class="py-10 lg:py-14 bg-base-200">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="text-sm text-base-content/50 mb-4">
        <a href="/vente" class="hover:text-primary transition-colors">← Retour aux annonces</a>
      </nav>

      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h1 class="text-3xl lg:text-4xl font-serif text-base-content">{title}</h1>
        <span class={`badge badge-lg ${espece === 'poney' ? 'badge-secondary' : 'badge-neutral'}`}>
          {espece === 'poney' ? 'Poney' : 'Cheval'}
        </span>
        {vendu && (
          <span class="badge badge-error badge-lg font-bold uppercase tracking-wide">Vendu</span>
        )}
      </div>
      <p class="text-base-content/60 text-lg">
        {race} · {sexeLabels[sexe]} · {ageLabel}
        {taille && ` · ${taille}`}
        {robe && ` · ${robe}`}
      </p>
    </div>
  </section>

  <!-- Main content: gallery + info -->
  <section class="py-10 lg:py-14 bg-base-100">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Gallery -->
        <div>
          {resolvedImages.length > 0 ? (
            <HorseGallery images={resolvedImages} horseName={title} />
          ) : (
            <div class="aspect-[4/3] rounded-xl bg-base-200 flex items-center justify-center text-base-content/20">
              <svg viewBox="0 0 120 80" class="w-32 h-24" fill="currentColor" aria-hidden="true">
                <path d="M95 18c-2-3-5-5-8-5l-3 1-2-4c-1-2-3-3-5-3h-6c-3 0-5 1-6 3l-4 8-10 4-8 2-8 6-5 8-3 10v10h6v-8l3-8 5-4 8-2 10-4 4-2 2 2v24h6V44l2-4 4-2h4l6 2 4 6v16h6V46l-2-8-3-6 4-7 4-5-1-2z" />
              </svg>
            </div>
          )}
        </div>

        <!-- Info panel -->
        <div class="flex flex-col gap-6">

          <!-- Price -->
          <div>
            <p class={`text-3xl font-bold ${vendu ? 'text-base-content/40 line-through' : 'text-primary'}`}>
              {prix}
            </p>
            {vendu && <p class="text-error font-semibold mt-1">Ce cheval a trouvé preneur</p>}
          </div>

          <!-- Key stats -->
          <dl class="grid grid-cols-2 gap-3 text-sm">
            <div class="bg-base-200 rounded-lg p-3">
              <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Espèce</dt>
              <dd class="font-medium capitalize">{espece}</dd>
            </div>
            <div class="bg-base-200 rounded-lg p-3">
              <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Sexe</dt>
              <dd class="font-medium">{sexeLabels[sexe]}</dd>
            </div>
            <div class="bg-base-200 rounded-lg p-3">
              <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Race</dt>
              <dd class="font-medium">{race}</dd>
            </div>
            <div class="bg-base-200 rounded-lg p-3">
              <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Âge</dt>
              <dd class="font-medium">{anneeNaissance} — {ageLabel}</dd>
            </div>
            {taille && (
              <div class="bg-base-200 rounded-lg p-3">
                <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Taille</dt>
                <dd class="font-medium">{taille}</dd>
              </div>
            )}
            {robe && (
              <div class="bg-base-200 rounded-lg p-3">
                <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Robe</dt>
                <dd class="font-medium">{robe}</dd>
              </div>
            )}
            {niveau && (
              <div class="bg-base-200 rounded-lg p-3 col-span-2">
                <dt class="text-base-content/50 text-xs uppercase tracking-wide mb-0.5">Niveau</dt>
                <dd class="font-medium">{niveau}</dd>
              </div>
            )}
          </dl>

          <!-- Disciplines -->
          {disciplines && disciplines.length > 0 && (
            <div>
              <p class="text-xs text-base-content/50 uppercase tracking-wide mb-2">Disciplines</p>
              <div class="flex flex-wrap gap-2">
                {disciplines.map((d) => (
                  <span class="badge badge-outline">{d}</span>
                ))}
              </div>
            </div>
          )}

          <!-- CTA buttons -->
          {!vendu && (
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <a
                href={phoneUrl}
                class="btn btn-primary btn-lg min-h-[44px]"
                aria-label={`Appeler pour ${title}`}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                Appeler
              </a>
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-lg min-h-[44px] text-gray-900 bg-[#25D366] border-[#25D366] hover:brightness-110"
                aria-label={`WhatsApp pour ${title}`}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                Demander une visite
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Markdown description -->
  <section class="py-10 lg:py-14 bg-base-200">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
