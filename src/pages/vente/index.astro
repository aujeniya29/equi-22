---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorseCard from '../../components/HorseCard.astro';
import { business } from '../../data/business';

const horses = await getCollection('vente');
const sorted = [...horses].sort((a, b) => {
  // Available horses first, then sold
  if (a.data.vendu !== b.data.vendu) return a.data.vendu ? 1 : -1;
  // Within each group: most recent first
  return b.data.anneeNaissance - a.data.anneeNaissance;
});

const allVenteImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/vente/**/*.{jpg,jpeg,png,webp}'
);

// Pre-resolve main photo for each horse
const heroImages = new Map<string, ImageMetadata>();
await Promise.all(
  sorted.map(async (horse) => {
    if (!horse.data.photoPrincipale) return;
    const key = `/src/assets/images/vente/${horse.id}/${horse.data.photoPrincipale}`;
    const mod = allVenteImages[key];
    if (mod) {
      const { default: img } = await mod();
      heroImages.set(horse.id, img);
    }
  })
);

const available = sorted.filter((h) => !h.data.vendu);
const sold = sorted.filter((h) => h.data.vendu);

const whatsappNumber = business.whatsapp.replace(/[^\d]/g, '');
const whatsappMessage = "Bonjour, je suis intéressé(e) par un cheval à vendre. Pourriez-vous me donner plus d'informations ?";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout
  title="Vente & dépôt-vente de chevaux et poneys — Équi 22"
  description="Chevaux et poneys à vendre au centre équestre Équi 22 à Yffiniac. Dépôt-vente possible : nous gérons valorisation, communication et prises de rendez-vous."
  whatsappMessage={whatsappMessage}
>
  <!-- Header -->
  <section class="py-12 lg:py-16 bg-base-200">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-3xl lg:text-4xl font-serif text-base-content mb-4">
        Vente & dépôt-vente
      </h1>
      <p class="text-base-content/70 max-w-2xl mx-auto">
        Retrouvez nos annonces de vente et découvrez comment nous pouvons vous accompagner dans la vente de votre équidé en dépôt-vente.
      </p>
    </div>
  </section>

  <!-- Work in progress banner -->
  <div class="bg-warning/15 border-y border-warning/30">
    <div class="max-w-4xl mx-auto px-4 py-4 flex items-center gap-3 text-warning-content">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-warning" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l5.654-4.654m5.65-4.652 3.033-2.498a2.626 2.626 0 0 1 3.71 3.71l-2.498 3.033m-5.245-5.245-2.993-2.993a2.626 2.626 0 0 0-3.71 3.71l2.993 2.993" />
      </svg>
      <p class="text-sm font-medium text-base-content/80">
        Cette page est en cours de conception — les annonces seront publiées prochainement.
      </p>
    </div>
  </div>

  <!-- Dépôt-vente -->
  <section class="py-12 lg:py-16 bg-base-100">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">
        Dépôt-vente de chevaux
      </h2>
      <p class="text-base-content/80 text-lg leading-relaxed mb-8">
        Vous souhaitez vendre votre équidé ? Nous vous accompagnons à chaque étape, dans un cadre professionnel et transparent.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div>
          <h3 class="text-base font-semibold text-primary uppercase tracking-wide mb-3">Ce que nous gérons</h3>
          <ul class="space-y-2 text-base-content/80">
            <li class="flex items-start gap-2"><span class="text-primary font-bold shrink-0 mt-0.5">•</span><span>Valorisation et travail de votre cheval</span></li>
            <li class="flex items-start gap-2"><span class="text-primary font-bold shrink-0 mt-0.5">•</span><span>Photos et communication</span></li>
            <li class="flex items-start gap-2"><span class="text-primary font-bold shrink-0 mt-0.5">•</span><span>Prise de rendez-vous avec les acheteurs</span></li>
            <li class="flex items-start gap-2"><span class="text-primary font-bold shrink-0 mt-0.5">•</span><span>Aucun frais de pension pendant la durée du dépôt</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-base font-semibold text-primary uppercase tracking-wide mb-3">Vos engagements</h3>
          <ul class="space-y-2 text-base-content/80">
            <li class="flex items-start gap-2"><span class="text-primary font-bold shrink-0 mt-0.5">•</span><span>Soins courants à votre charge : vermifuge, vaccins, dentiste, ostéo, maréchalerie</span></li>
          </ul>
        </div>
      </div>

      <div class="space-y-3 text-base-content/80 leading-relaxed mb-8">
        <p>
          Un contrat est signé entre les deux parties. Vous fixez votre prix net vendeur, nous y ajoutons notre commission — sans surprise. Si la vente n'aboutit pas dans le premier mois, une réévaluation des conditions peut être envisagée ensemble ; la commission, elle, reste fixe.
        </p>
        <p class="text-sm text-base-content/70 italic">
          Seuls les chevaux débourrés, en état physique et mental satisfaisant sont acceptés. Nous nous réservons le droit de refuser certains dossiers.
        </p>
      </div>

      <a
        href="/documents/depot%20vente%202026.pdf"
        download="depot vente 2026.pdf"
        class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl border border-base-300 bg-base-100 hover:border-primary hover:shadow-md transition-all group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <span class="text-primary shrink-0" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </span>
        <span class="font-medium text-base-content group-hover:text-primary transition-colors">
          Contrat de dépôt-vente 2026
        </span>
        <span class="ml-2 text-xs text-base-content/40 uppercase tracking-wide">PDF</span>
      </a>
    </div>
  </section>

  <!-- Available horses -->
  {available.length > 0 ? (
    <section class="py-12 lg:py-16 bg-base-200">
      <div class="max-w-6xl mx-auto px-4">
        {available.length > 0 && sold.length > 0 && (
          <h2 class="text-xl font-serif text-base-content mb-6">Disponibles</h2>
        )}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
          {available.map((horse) => (
            <HorseCard horse={horse} heroImage={heroImages.get(horse.id)} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="py-16 lg:py-24 bg-base-200">
      <div class="max-w-2xl mx-auto px-4 text-center">
        <p class="text-base-content/70 text-lg">
          Aucune annonce disponible pour le moment. Revenez bientôt ou contactez-nous directement.
        </p>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6">
          Nous contacter par WhatsApp
        </a>
      </div>
    </section>
  )}

  <!-- Sold horses (if any) -->
  {sold.length > 0 && (
    <section class="py-12 lg:py-16 bg-base-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-xl font-serif text-base-content/70 mb-6">Déjà partis</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
          {sold.map((horse) => (
            <HorseCard horse={horse} heroImage={heroImages.get(horse.id)} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-12 lg:py-16 bg-base-100">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">
        Une question ? Envie de visiter ?
      </h2>
      <p class="text-base-content/70 mb-8 max-w-xl mx-auto">
        Appelez-nous ou envoyez un message pour convenir d'un rendez-vous — les chevaux sont disponibles à la visite au centre équestre Equi 22 à Yffiniac.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:${business.phone.replace(/\s/g, '')}`}
          class="btn btn-primary btn-lg min-h-[44px]"
          aria-label="Appeler le centre équestre"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Appeler
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg min-h-[44px] text-gray-900 bg-[#25D366] border-[#25D366] hover:brightness-110"
          aria-label="Envoyer un message WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
