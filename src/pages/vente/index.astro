---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HorseCard from '../../components/HorseCard.astro';
import { business } from '../../data/business';

const horses = await getCollection('vente');
const sorted = [...horses].sort((a, b) => {
  // Available horses first, then sold
  if (a.data.vendu !== b.data.vendu) return a.data.vendu ? 1 : -1;
  // Within each group: most recent first
  return b.data.anneeNaissance - a.data.anneeNaissance;
});

const allVenteImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/vente/**/*.{jpg,jpeg,png,webp}'
);

// Pre-resolve main photo for each horse
const heroImages = new Map<string, ImageMetadata>();
await Promise.all(
  sorted.map(async (horse) => {
    if (!horse.data.photoPrincipale) return;
    const key = `/src/assets/images/vente/${horse.id}/${horse.data.photoPrincipale}`;
    const mod = allVenteImages[key];
    if (mod) {
      const { default: img } = await mod();
      heroImages.set(horse.id, img);
    }
  })
);

const available = sorted.filter((h) => !h.data.vendu);
const sold = sorted.filter((h) => h.data.vendu);

const whatsappNumber = business.whatsapp.replace(/[^\d]/g, '');
const whatsappMessage = "Bonjour, je suis intéressé(e) par un cheval à vendre. Pourriez-vous me donner plus d'informations ?";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout
  title="Chevaux et poneys à vendre"
  description="Découvrez les chevaux et poneys à vendre au centre équestre Equi 22 à Yffiniac. Fiches détaillées, galerie photos, contact direct."
  whatsappMessage={whatsappMessage}
>
  <!-- Header -->
  <section class="py-12 lg:py-16 bg-base-200">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-3xl lg:text-4xl font-serif text-base-content mb-4">
        Chevaux & Poneys à vendre
      </h1>
      <p class="text-base-content/70 max-w-2xl mx-auto">
        Retrouvez ici nos annonces de vente. Chaque fiche détaille le profil, le niveau et les photos du cheval ou poney concerné. Contactez-nous pour organiser une visite.
      </p>
    </div>
  </section>

  <!-- Available horses -->
  {available.length > 0 ? (
    <section class="py-12 lg:py-16 bg-base-100">
      <div class="max-w-6xl mx-auto px-4">
        {available.length > 0 && sold.length > 0 && (
          <h2 class="text-xl font-serif text-base-content mb-6">Disponibles</h2>
        )}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {available.map((horse) => (
            <HorseCard horse={horse} heroImage={heroImages.get(horse.id)} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="py-16 lg:py-24 bg-base-100">
      <div class="max-w-2xl mx-auto px-4 text-center">
        <p class="text-base-content/60 text-lg">
          Aucune annonce disponible pour le moment. Revenez bientôt ou contactez-nous directement.
        </p>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6">
          Nous contacter par WhatsApp
        </a>
      </div>
    </section>
  )}

  <!-- Sold horses (if any) -->
  {sold.length > 0 && (
    <section class="py-12 lg:py-16 bg-base-200">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-xl font-serif text-base-content/60 mb-6">Déjà partis</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {sold.map((horse) => (
            <HorseCard horse={horse} heroImage={heroImages.get(horse.id)} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class={`py-12 lg:py-16 ${sold.length > 0 ? 'bg-base-100' : 'bg-base-200'}`}>
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl lg:text-3xl font-serif text-base-content mb-4">
        Une question ? Envie de visiter ?
      </h2>
      <p class="text-base-content/70 mb-8 max-w-xl mx-auto">
        Appelez-nous ou envoyez un message pour convenir d'un rendez-vous — les chevaux sont disponibles à la visite au centre équestre Equi 22 à Yffiniac.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:${business.phone.replace(/\s/g, '')}`}
          class="btn btn-primary btn-lg min-h-[44px]"
          aria-label="Appeler le centre équestre"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Appeler
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-lg min-h-[44px] text-gray-900 bg-[#25D366] border-[#25D366] hover:brightness-110"
          aria-label="Envoyer un message WhatsApp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
